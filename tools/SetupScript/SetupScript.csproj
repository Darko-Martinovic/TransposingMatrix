<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Writes TransposingMatrix/Setup/Setup.sql from Setup.template.sql and the assembly:
    run it in Release, as the README describes under Building and testing
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Builds the assembly first, in the same configuration; nothing of it is referenced -->
    <ProjectReference Include="..\..\TransposingMatrix\TransposingMatrix.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="RepositoryRoot" Value="$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../..'))" />
    <AssemblyMetadata Include="MatrixAssembly" Value="$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../TransposingMatrix/bin/$(Configuration)/net48/SimpleTalk.SQLCLR.Matrix.dll'))" />
  </ItemGroup>

</Project>
