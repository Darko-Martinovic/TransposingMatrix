<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SQL Server runs CLR assemblies on .NET Framework 4.x only, up to SQL Server 2025,
    so this is the one project that can't move to modern .NET.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>SimpleTalk.SQLCLR.Matrix</AssemblyName>
    <RootNamespace>TransposingMatrix</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>2.0.0</Version>
    <Company>Darko Martinovic</Company>
    <Product>TransposingMatrix</Product>
    <Description>An Easier Way of Transposing Query Result in SQL Server</Description>
    <Copyright>Darko Martinovic</Copyright>
    <!-- Setup.sql carries the assembly: no debug directory with a local path in it -->
    <DebugType>none</DebugType>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets dotnet build compile for .NET Framework on any OS -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
